# Setup Environment configuration variables example
# Copy this to .env in your running environment

# PORT to bind the Express API, defaults to 3000
PORT=3000

# Auth integrations credentials - IMPORTANT for resume tailoring and scoring
# Use your direct claude sonnet keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional gateway url for Anthropic
# ANTHROPIC_BASE_URL=https://api.anthropic.com
